{
  "title": "Clarvynn Cost Savings Demo",
  "uid": "clarvynn-cost-demo-comprehensive",
  "annotations": {
    "list": []
  },
  "editable": true,
  "gnetId": null,
  "graphTooltip": 0,
  "panels": [
    {
      "id": 1,
      "title": "Ingestion Cost (This Test)",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "expr": "(sum(otelcol_receiver_accepted_spans_total) * 500 / 1000000000 * 0.10) + (sum(otelcol_receiver_accepted_log_records_total) * 1200 / 1000000000 * 0.50)",
          "refId": "A",
          "legendFormat": "Total Cost"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 0.001,
                "color": "yellow"
              },
              {
                "value": 0.01,
                "color": "red"
              }
            ]
          }
        }
      },
      "options": {
        "graphMode": "area",
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "description": "Ingestion cost for THIS TEST based on total traces and logs. Traces: 0.5KB @ $0.10/GB, Logs: 1.2KB @ $0.50/GB."
    },
    {
      "id": 9,
      "title": "Estimated Monthly Ingestion Cost",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "((sum(otelcol_receiver_accepted_spans_total) * 500 / 1000000000 * 0.10) + (sum(otelcol_receiver_accepted_log_records_total) * 1200 / 1000000000 * 0.50)) * 2880",
          "refId": "A",
          "legendFormat": "Monthly Cost"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 50,
                "color": "yellow"
              },
              {
                "value": 100,
                "color": "red"
              }
            ]
          }
        }
      },
      "options": {
        "graphMode": "area",
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "description": "Estimated MONTHLY cost if this traffic pattern continues 8 hours/day for 30 days. Multiplier: 2880x (96 five-min periods/day × 30 days)."
    },
    {
      "id": 2,
      "title": "Observability Data Volume",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(rate(otelcol_receiver_accepted_spans_total[5m])) * 60",
          "refId": "A",
          "legendFormat": "Traces/min"
        },
        {
          "expr": "sum(rate(otelcol_receiver_accepted_log_records_total[5m])) * 60",
          "refId": "B",
          "legendFormat": "Logs/min"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 20,
            "lineWidth": 2
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Traces/min"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Logs/min"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 3,
      "title": "Application Traffic",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_duration_milliseconds_count[5m])) * 60",
          "refId": "A",
          "legendFormat": "HTTP Requests/min"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "lineWidth": 2
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        }
      },
      "description": "Total HTTP requests per minute (should remain constant between vanilla and Clarvynn)"
    },
    {
      "id": 4,
      "title": "Trace Export %",
      "type": "gauge",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 8
      },
      "targets": [
        {
          "expr": "(sum(otelcol_receiver_accepted_spans_total) / sum(http_server_duration_milliseconds_count)) * 100",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 150,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": 0,
                "color": "green"
              },
              {
                "value": 30,
                "color": "yellow"
              },
              {
                "value": 70,
                "color": "red"
              }
            ]
          }
        }
      },
      "options": {
        "showThresholdLabels": true,
        "showThresholdMarkers": true
      },
      "description": "Traces exported / HTTP requests. ~100% = vanilla OTEL (all traced). ~15% = Clarvynn (85% cost savings). Can exceed 100% due to OTEL internal spans."
    },
    {
      "id": 5,
      "title": "Log Export %",
      "type": "gauge",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 8
      },
      "targets": [
        {
          "expr": "(sum(otelcol_receiver_accepted_log_records_total) / (sum(http_server_duration_milliseconds_count) * 4.2)) * 100",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 150,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": 0,
                "color": "green"
              },
              {
                "value": 30,
                "color": "yellow"
              },
              {
                "value": 70,
                "color": "red"
              }
            ]
          }
        }
      },
      "options": {
        "showThresholdLabels": true,
        "showThresholdMarkers": true
      },
      "description": "Logs exported / expected logs (~4.2 logs per request). ~100% = vanilla OTEL. ~15% = Clarvynn. Logs follow trace decisions via Flight Recorder."
    },
    {
      "id": 6,
      "title": "Total Errors",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum(http_server_duration_milliseconds_count{http_status_code=~\"[45]..\"}) or vector(0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              }
            ]
          }
        }
      },
      "options": {
        "graphMode": "area",
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value"
      },
      "description": "Total 4xx and 5xx errors in this test. Compare between vanilla and Clarvynn runs - should be identical, proving 100% error capture."
    },
    {
      "id": 7,
      "title": "Request Breakdown by Status",
      "type": "piechart",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum(increase(http_server_duration_milliseconds_count{http_status_code=~\"2..\"}[5m]))",
          "refId": "A",
          "legendFormat": "Success (2xx)"
        },
        {
          "expr": "sum(increase(http_server_duration_milliseconds_count{http_status_code=~\"4..\"}[5m]))",
          "refId": "B",
          "legendFormat": "Client Errors (4xx)"
        },
        {
          "expr": "sum(increase(http_server_duration_milliseconds_count{http_status_code=~\"5..\"}[5m]))",
          "refId": "C",
          "legendFormat": "Server Errors (5xx)"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value",
            "percent"
          ]
        },
        "pieType": "donut"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 8,
      "title": "Total Data Exported",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum(otelcol_receiver_accepted_spans_total) or vector(0)",
          "refId": "A",
          "legendFormat": "Traces (Total)"
        },
        {
          "expr": "sum(otelcol_receiver_accepted_log_records_total) or vector(0)",
          "refId": "B",
          "legendFormat": "Logs (Total)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Traces (Total)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Logs (Total)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "graphMode": "none",
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "background"
      },
      "description": "Total traces and logs exported in this test."
    }
  ],
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "timezone": "",
  "schemaVersion": 27,
  "version": 1,
  "refresh": "5s"
}